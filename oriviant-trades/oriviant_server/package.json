{
  "name": "oriviant-server",
  "version": "1.0.0",
  "description": "Backend API for Oriviant",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "init-db": "tsx src/scripts/initDb.ts",
    "make-admin": "tsx src/scripts/makeAdmin.ts",
    "reconcile": "tsx src/scripts/reconcile.ts",
    "seed-admin": "tsx src/scripts/seedAdmin.ts",
    "seed-markets": "tsx src/scripts/seedMarkets.ts",
    "demo-traders": "tsx src/scripts/demoTraders.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5"
  }
}
